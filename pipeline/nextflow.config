// Hand-written. main.nf beside it is generated by the Code Ocean pipeline builder --
// it carries a hash:sha256 marker -- and is overwritten whenever the pipeline is saved
// in the UI. Keep configuration here so it survives a regeneration.

process {
    maxForks = 50
    queueSize = 50
}

// Attributes AIND's cost monitoring groups batch jobs by.
process.resourceLabels = ['allen-batch-pipeline': 'exaspim-swc-processing']

// Read by the packaging capsule to fill Processing.pipelines. Without them it falls back
// to its own defaults and records version 0.0.0.
//
// PIPELINE_VERSION is the semantic version and must agree with CHANGELOG.md and the
// release tag. It is not the MAJOR.0 version Code Ocean assigns at internal release;
// both may appear in historical metadata.
env {
    PIPELINE_URL = "https://github.com/peter-grotz/exaspim-swc-processing-pipeline"
    PIPELINE_NAME = "exaspim-swc-processing"
    PIPELINE_VERSION = "0.1.0"
}
